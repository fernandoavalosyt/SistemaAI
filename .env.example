###############################################################################
# Vigilia — Variables de Entorno (Template)
# Copia este archivo como .env y llena los valores necesarios.
###############################################################################

# ---- Puertos de los servicios -----------------------------------------------
IA_PORT=8001            # modelo-ia: visualizador Byrack (/stream) + /health
ALERT_PORT=8080         # modelo-ia: UI de alertas de pruebas
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ---- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=vigilia_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- MongoDB ----------------------------------------------------------------
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=vigilia_db
MONGO_HOST=mongodb
MONGO_PORT=27017

# ---- Redis ------------------------------------------------------------------
REDIS_PASSWORD=
REDIS_HOST=redis
REDIS_PORT=6379

# ---- RabbitMQ ---------------------------------------------------------------
RABBITMQ_USER=
RABBITMQ_PASSWORD=
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ---- MinIO (Object Storage) ------------------------------------------------
MINIO_USER=
MINIO_PASSWORD=
MINIO_HOST=minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_VIDEOS=vigilia-videos
MINIO_BUCKET_FRAMES=vigilia-frames
MINIO_BUCKET_RESULTS=vigilia-results

# ---- JWT --------------------------------------------------------------------
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---- Gemini AI --------------------------------------------------------------
GEMINI_API_KEY=

# ---- Frontend ---------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws
