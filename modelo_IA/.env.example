###############################################################################
# Vigilia — modelo_IA: variables del pipeline (template)
# Copia estas lineas a modelo_IA/.env y completa la camara.
# En Docker, docker-compose.yml fuerza ALERT_HOST/VISUALIZER_HOST=0.0.0.0 y
# ALERT_OPEN_BROWSER=false.
###############################################################################

# ---- S1 Camara IP (RTSP) -----------------------------------------------------
VIDEO_CAMERA_ID=CAM-01
VIDEO_SOURCE_TYPE=RTSP_CAMERA
# Sin usuario/contrasena en la URL: van en RTSP_USER / RTSP_PASSWORD.
RTSP_URL=rtsp://192.168.1.64:554/Streaming/Channels/101
RTSP_USER=
RTSP_PASSWORD=
RTSP_TRANSPORT=tcp
VIDEO_TARGET_FPS=10
# Reintentos con backoff (tope 30 s entre intentos); alto para camaras IP.
VIDEO_MAX_RECONNECT_ATTEMPTS=1000

# ---- S3 / S5 Modelos ---------------------------------------------------------
AUTO_DOWNLOAD_MODELS=true
MODEL_PATH=models/yolov8n.pt
MODEL_DEVICE=cpu
MODEL_PRECISION=fp32
MODEL_CONF_THRESHOLD=0.35
# 0 = solo personas (el resto del pipeline solo analiza personas)
MODEL_CLASS_WHITELIST=0
POSE_MODEL_PATH=models/yolov8n-pose.pt
POSE_DEVICE=cpu

# ---- S6 / S7 Zonas, contexto y reglas ----------------------------------------
BEHAVIOR_ZONES_FILE=config/zones.json
DECISION_CONTEXT_FILE=config/camera_context.json
# DECISION_RULES_FILE=config/rules.json

# ---- S8 / S9 / S10 -----------------------------------------------------------
EVIDENCE_STORAGE_ROOT=evidence_store
ALERT_PORT=8080
ALERT_OPEN_BROWSER=true
VISUALIZER_PORT=8001
